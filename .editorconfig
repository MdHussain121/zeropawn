root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{py,pyi}]
indent_size = 4
max_line_length = 100

[*.{cpp,hpp,h,c}]
indent_size = 4

[*.{json,yaml,yml,toml}]
indent_size = 2

[*.{cmd,bat}]
end_of_line = crlf
indent_size = 4

[*.md]
trim_trailing_whitespace = false
