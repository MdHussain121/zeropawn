"""Type stubs for the zeropawn_cpp pybind11 extension."""

from collections.abc import Callable
from typing import Any, Optional
import numpy as np
import numpy.typing as npt

def version() -> str: ...
def encode_state(game: ChessGame) -> npt.NDArray[np.float32]: ...
def move_to_index(game: ChessGame, uci: str) -> int: ...
def index_to_move(game: ChessGame, index: int) -> str: ...

class Game:
    def clone(self) -> Game: ...
    def legal_actions(self) -> list[int]: ...
    def apply_action(self, action: int) -> None: ...
    def is_terminal(self) -> bool: ...
    def terminal_value(self) -> float: ...
    def get_hash(self) -> int: ...
    def num_planes(self) -> int: ...
    def state_size(self) -> int: ...
    def num_actions(self) -> int: ...
    def action_to_string(self, action: int) -> str: ...
    def string_to_action(self, uci: str) -> int: ...

class ChessGame(Game):
    def __init__(self, fen: str = ...) -> None: ...
    def clone(self) -> ChessGame: ...
    def set_fen(self, fen: str) -> bool: ...
    def get_fen(self) -> str: ...
    def legal_moves_uci(self) -> list[str]: ...
    def is_legal(self, uci: str) -> bool: ...
    def make_move_uci(self, uci: str) -> bool: ...
    def unmake_move(self) -> bool: ...
    def side_to_move(self) -> bool: ...
    def in_check(self) -> bool: ...
    def is_game_over(self) -> bool: ...
    def is_checkmate(self) -> bool: ...
    def is_stalemate(self) -> bool: ...
    def is_repetition(self, count: int = ...) -> bool: ...
    def is_50_move_rule(self) -> bool: ...
    def is_insufficient_material(self) -> bool: ...
    def half_move_clock(self) -> int: ...
    def full_move_number(self) -> int: ...
    def perft(self, depth: int) -> int: ...

class Connect4(Game):
    ROWS: int
    COLS: int
    def current_player(self) -> int: ...
    def cell(self, r: int, c: int) -> int: ...
    def winner(self) -> int: ...
    def encode_state(self) -> npt.NDArray[np.float32]: ...

class MCTSConfig:
    c_puct: float
    dirichlet_alpha: float
    dirichlet_weight: float
    fpu_reduction: float
    virtual_loss: int
    add_noise: bool
    seed: int
    reuse_tree: bool
    max_nodes: int
    batch_size: int
    def __init__(self) -> None: ...

class SearchResult:
    best_action: int
    action_visits: npt.NDArray[np.float32]
    root_value: float
    retained_visits: int
    new_simulations: int
    batch_size: int

class MCTS:
    def __init__(self, config: MCTSConfig = ...) -> None: ...
    def clear(self) -> None: ...
    def set_seed(self, seed: int) -> None: ...
    def cache_size(self) -> int: ...
    def advance_root(self, *args: Any) -> bool: ...
    def reset_root(self) -> None: ...
    def live_node_count(self) -> int: ...
    def has_retained_root(self) -> bool: ...
    def retained_visits(self) -> int: ...
    def total_active_virtual_losses(self) -> int: ...
    @staticmethod
    def total_allocated_nodes() -> int: ...
    @staticmethod
    def total_freed_nodes() -> int: ...
    @staticmethod
    def reset_node_alloc_stats() -> None: ...
    def search(
        self,
        game: Game,
        num_simulations: int,
        evaluator: Callable[[Game], tuple[list[float], float]],
        batch_evaluator: Optional[Callable[[list[Game]], list[tuple[list[float], float]]]] = None,
    ) -> SearchResult: ...
